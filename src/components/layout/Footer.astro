---
import { themeConfig } from '@/config'
const today = new Date()
---

<footer>
  <div class="footer-content">
    <div class="copyright">
      <span class="date">
        &copy;
        {today.getFullYear()}
      </span>
      {themeConfig.site.author}
    </div>
    <div class="footer-links">
      <a href="/Fauzan_Fathurrahman_Resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
      <span class="powered-by">
        Powered by{' '}
        <a href="https://astro.build">Astro</a> &{' '}
        <a href="https://github.com/the3ash/astro-chiri">Chiri</a>
      </span>
    </div>
  </div>
</footer>
<style>
  footer {
    font-size: var(--font-size-s);
    font-weight: var(--font-weight-light);
    line-height: 1.75;
    color: var(--text-secondary);
    opacity: 0.75;
    margin-top: 4rem;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    width: 100%;
  }

  .copyright {
    white-space: nowrap;
  }

  .footer-links {
    white-space: nowrap;
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  @media (max-width: 360px) {
    .footer-content {
      justify-content: flex-start;
    }
  }

  .copyright .date {
    opacity: 1;
  }

  footer a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease-out;
  }

  footer a:hover {
    color: var(--text-primary);
  }
</style>
