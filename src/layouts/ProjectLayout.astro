---
import '@/styles/global.css'
import BaseHead from '@/components/layout/BaseHead.astro'
import Footer from '@/components/layout/Footer.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { themeConfig } from '@/config'

const { title, description, image, tech, live, github } = Astro.props
---

<BaseLayout title={`${title} · ${themeConfig.site.title}`} description={description}>
  <BaseHead title={`${title} · ${themeConfig.site.title}`} description={description} slot="head" />
  <div class="project-container">
    <main>
      <a href="/projects" class="back-link">← Projects</a>
      
      <article class="project-detail">
        {image && (
          <div class="project-hero">
            <img src={`/projects/${image}`} alt={title} />
          </div>
        )}
        
        <header class="project-header">
          <h1>{title}</h1>
          <p class="project-desc">{description}</p>
          
          {tech && tech.length > 0 && (
            <div class="project-tech">
              {tech.map((t: string) => (
                <span class="tech-chip">{t}</span>
              ))}
            </div>
          )}
          
          <div class="project-links">
            {live && (
              <a href={live} target="_blank" rel="noopener noreferrer" class="project-link">
                View Live ↗
              </a>
            )}
            {github && (
              <a href={github} target="_blank" rel="noopener noreferrer" class="project-link">
                GitHub ↗
              </a>
            )}
          </div>
        </header>
        
        <div class="project-content prose">
          <slot />
        </div>
      </article>
    </main>
  </div>
  
  <Footer />
</BaseLayout>

<style>
  .project-container {
    max-width: 45rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  
  .back-link {
    display: inline-block;
    font-family: var(--serif);
    font-size: var(--font-size-m);
    font-style: italic;
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.2s ease;
  }
  
  .back-link:hover {
    color: var(--text-primary);
  }
  
  .project-detail {
    margin-top: 0.5rem;
  }
  
  .project-hero {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    margin-bottom: 1.75rem;
    background: var(--code-bg);
  }
  
  .project-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .project-header {
    margin-bottom: 2.5rem;
  }
  
  .project-header h1 {
    font-size: 1.75rem;
    font-weight: var(--font-weight-bold);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }
  
  .project-desc {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
  }
  
  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1.25rem;
  }
  
  .tech-chip {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-secondary);
    font-family: var(--mono);
  }
  
  .project-links {
    display: flex;
    gap: 0.75rem;
  }
  
  .project-link {
    font-size: var(--font-size-m);
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--mono);
    padding: 0.4rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: all 0.2s ease;
  }
  
  .project-link:hover {
    background: var(--code-bg);
    border-color: var(--text-tertiary);
  }
  
  .project-content {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>