---
import '@/styles/global.css'
import BaseHead from '@/components/layout/BaseHead.astro'
import Footer from '@/components/layout/Footer.astro'
import BackButton from '@/components/ui/BackButton.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { themeConfig } from '@/config'

const { title, description, image, tech, live, github } = Astro.props
---

<BaseLayout title={`${title} · ${themeConfig.site.title}`} description={description}>
  <BaseHead title={`${title} · ${themeConfig.site.title}`} description={description} slot="head" />
  <div class="project-container">
    <main>
      <BackButton href="/projects" label="All Projects" />
      
      <article class="project-detail">
        {image && (
          <div class="project-hero">
            <img src={`/projects/${image}`} alt={title} />
          </div>
        )}
        
        <header class="project-header">
          <h1>{title}</h1>
          <p class="project-desc">{description}</p>
          
          {tech && tech.length > 0 && (
            <div class="project-tech">
              {tech.map((t: string) => (
                <span class="tech-chip">{t}</span>
              ))}
            </div>
          )}
          
          <div class="project-links">
            {live && (
              <a href={live} target="_blank" rel="noopener noreferrer" class="project-link">
                View Live ↗
              </a>
            )}
            {github && (
              <a href={github} target="_blank" rel="noopener noreferrer" class="project-link">
                GitHub ↗
              </a>
            )}
          </div>
        </header>
        
        <div class="project-content prose">
          <slot />
        </div>
      </article>
    </main>
  </div>
  
  <Footer />
</BaseLayout>

<style>
  .project-container {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  
  .project-detail {
    margin-top: 1rem;
  }
  
  .project-hero {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 2rem;
    background: var(--code-bg);
  }
  
  .project-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .project-header {
    margin-bottom: 3rem;
  }
  
  .project-header h1 {
    font-size: 2rem;
    font-weight: var(--font-weight-bold);
    margin: 0 0 0.75rem 0;
    line-height: 1.3;
  }
  
  .project-desc {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }
  
  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  
  .tech-chip {
    font-size: var(--font-size-s);
    padding: 0.25rem 0.625rem;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-secondary);
    font-family: var(--mono);
  }
  
  .project-links {
    display: flex;
    gap: 1rem;
  }
  
  .project-link {
    font-size: var(--font-size-m);
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--mono);
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: all 0.2s ease;
  }
  
  .project-link:hover {
    background: var(--code-bg);
    border-color: var(--text-tertiary);
  }
  
  .project-content {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
</style>