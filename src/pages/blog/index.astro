---
import IndexLayout from '@/layouts/IndexLayout.astro'
import { themeConfig } from '@/config'
import PostList from '@/components/widgets/PostList.astro'
import { getSortedFilteredPosts } from '@/utils/draft'

const allPosts = await getSortedFilteredPosts()
const englishPosts = allPosts.filter(post => !post.data.lang || post.data.lang === 'en')
const indonesianPosts = allPosts.filter(post => post.data.lang === 'id')

const categoryLabels: Record<string, string> = {
  engineering: 'Engineering',
  building: 'Building',
  learning: 'Learning',
  personal: 'Personal'
}
const categories = Object.keys(categoryLabels).filter((c) =>
  allPosts.some((p) => p.data.category === c)
)
---

<IndexLayout
  title={`Blog · ${themeConfig.site.title}`}
  description={themeConfig.site.description}
  ogImage="/open-graph/blog.png"
>
  <div style="margin-top: 1rem;">
    <h1 style="margin: 0 0 0.5rem; font-size: 2rem; font-weight: 700;">Blog</h1>
    <p style="margin-bottom: 1.5rem; color: var(--text-secondary); font-size: 1.1rem;">
      Notes on <mark>software engineering, building things, technology, books, and the occasional rabbit hole</mark>.
    </p>
  </div>
  <div class="blog-search" id="blog-search"></div>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js" defer></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        new window.PagefindUI({
          element: '#blog-search',
          showImages: false,
          showSubResults: true
        })
      } else {
        // Pagefind index only exists post-build (absent in `astro dev`) —
        // collapse the reserved box instead of showing an empty gap
        const el = document.getElementById('blog-search')
        if (el) el.style.display = 'none'
      }
    })
  </script>

  {categories.length > 0 && (
    <div class="cat-filter" role="group" aria-label="Filter posts by category">
      <button type="button" class="filter-chip active" data-category="all">All</button>
      {categories.map((c) => (
        <button type="button" class="filter-chip" data-category={c}>{categoryLabels[c]}</button>
      ))}
    </div>
  )}

  <script is:inline>
    ;(function () {
      const chips = document.querySelectorAll('.cat-filter .filter-chip')
      if (!chips.length) return
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.remove('active'))
          chip.classList.add('active')
          const cat = chip.dataset.category
          document.querySelectorAll('li[data-category]').forEach((li) => {
            li.style.display = cat === 'all' || li.dataset.category === cat ? '' : 'none'
          })
          document.querySelectorAll('.language-section').forEach((sec) => {
            const any = [...sec.querySelectorAll('li[data-category]')].some(
              (li) => li.style.display !== 'none'
            )
            sec.style.display = any ? '' : 'none'
          })
        })
      })
    })()
  </script>

  <div style="padding-top: 3rem;">
    <PostList posts={englishPosts} />
    {indonesianPosts.length > 0 && (
      <div class="language-section">
        <h2 class="language-heading">Bahasa Indonesia</h2>
        <PostList posts={indonesianPosts} />
      </div>
    )}
  </div>
</IndexLayout>

<style>
  /* Reserve space before PagefindUI mounts (CLS) */
  .cat-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .filter-chip {
    font-family: var(--mono);
    font-size: var(--font-size-s);
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: transparent;
    color: var(--text-secondary-strong);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .filter-chip:hover {
    background: var(--code-bg);
    border-color: var(--text-tertiary);
  }

  .filter-chip.active {
    background: var(--text-primary);
    border-color: var(--text-primary);
    color: var(--bg);
  }

  .blog-search {
    min-height: 3rem;
    margin-top: 0;
    --pagefind-ui-primary: var(--text-primary);
    --pagefind-ui-text: var(--text-secondary-strong);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-background: transparent;
    --pagefind-ui-font: var(--sans);
  }

  .blog-search :where(input.pagefind-ui__search-input) {
    border-radius: 6px;
    background: transparent;
  }

  .language-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .language-heading {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }
</style>
