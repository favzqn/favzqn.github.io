---
import IndexLayout from '@/layouts/IndexLayout.astro'
const isDev = import.meta.env.DEV
---

<IndexLayout title="Search" description="Search all posts and content">
  <div class="search-container">
    <h1>Search</h1>
    {isDev ? (
      <p class="dev-notice">Search requires a production build. Run <code>pnpm build</code> then <code>pnpm preview</code> to test.</p>
    ) : (
      <div id="search"></div>
    )}
  </div>
</IndexLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline>
  window.addEventListener('DOMContentLoaded', async () => {
    const { PagefindUI } = await import('/pagefind/pagefind-ui.js')
    new PagefindUI({
      element: '#search',
      showSubResults: true,
      resetStyles: false
    })
  })
</script>

<style>
  .search-container {
    padding: 0 0 2rem;
  }

  .search-container h1 {
    margin-bottom: 1.5rem;
  }

  .dev-notice {
    color: var(--text-secondary);
    border: 2px dashed var(--border-color);
    padding: 1rem;
    border-radius: 0.375rem;
  }

  .dev-notice code {
    background: var(--bg-secondary);
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  :global(.pagefind-ui__search-input) {
    background: var(--bg-secondary) !important;
    border: 2px solid var(--border-color) !important;
    color: var(--text-primary) !important;
    border-radius: 0.375rem !important;
  }

  :global(.pagefind-ui__search-input:focus) {
    border-color: var(--accent, #3b82f6) !important;
    outline: none !important;
  }

  :global(.pagefind-ui__result) {
    border-bottom: 1px solid var(--border-color) !important;
    padding: 1rem 0 !important;
  }

  :global(.pagefind-ui__result-title a) {
    color: var(--text-primary) !important;
    font-weight: 600 !important;
  }

  :global(.pagefind-ui__result-excerpt) {
    color: var(--text-secondary) !important;
  }

  :global(.pagefind-ui__message) {
    color: var(--text-secondary) !important;
  }

  :global(.pagefind-ui__button) {
    background: var(--bg-secondary) !important;
    border: 2px solid var(--border-color) !important;
    color: var(--text-primary) !important;
    border-radius: 0.375rem !important;
  }

  :global(.pagefind-ui__button:hover) {
    border-color: var(--accent, #3b82f6) !important;
  }
</style>
