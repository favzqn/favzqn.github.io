---
import IndexLayout from '@/layouts/IndexLayout.astro'
import About from '@/components/widgets/About.astro'
import Recommendations from '@/components/widgets/Recommendations.astro'
import { themeConfig } from '@/config'

const title = `${themeConfig.site.title} — Full-stack Engineer & Automation Specialist`
---

<IndexLayout
  title={title}
  description={themeConfig.site.description}
  ogImage="/open-graph/home.png"
>
  <a class="status-pill" href="/hire">
    <span class="status-dot" aria-hidden="true"></span>
    Available for new projects · AEST-friendly hours
  </a>

  <About />

  <div class="home-stats" aria-label="Impact at a glance">
    <div class="stat">
      <span class="stat-value">900+</span>
      <span class="stat-label">pull requests merged</span>
    </div>
    <div class="stat">
      <span class="stat-value">80%</span>
      <span class="stat-label">faster regression time</span>
    </div>
    <div class="stat">
      <span class="stat-value">180+</span>
      <span class="stat-label">engineers mentored</span>
    </div>
    <div class="stat">
      <span class="stat-value">30+</span>
      <span class="stat-label">chatbots shipped</span>
    </div>
  </div>

  <nav class="quick-links" aria-label="What are you looking for">
    <p class="quick-ask">What are you looking for?</p>
    <div class="chips">
      <a href="/hire">Hire me</a>
      <a href="/projects">Case studies</a>
      <a href="/experience">Experience</a>
      <a href="/blog">Writing</a>
      <a href="/Fauzan_Fathurrahman_Resume.pdf" target="_blank" rel="noopener noreferrer">Resume ↗</a>
    </div>
  </nav>
  <Recommendations />
</IndexLayout>

<style>
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: var(--font-size-s);
    color: var(--text-primary);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .status-pill:hover {
    background: var(--code-bg);
    border-color: var(--text-tertiary);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
    flex-shrink: 0;
  }

  .home-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 1.25rem;
    margin: 2rem 0;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stat-value {
    display: block;
    font-size: 1.75rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--spacing-s);
    line-height: 1.2;
  }

  .stat-label {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--font-size-s);
    color: var(--text-secondary-strong);
  }

  .quick-links {
    margin-top: 2.5rem;
  }

  .quick-ask {
    margin: 0 0 0.6rem;
    font-family: var(--mono);
    font-size: var(--font-size-s);
    color: var(--text-secondary-strong);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chips a {
    font-family: var(--mono);
    font-size: var(--font-size-s);
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-primary);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .chips a:hover {
    background: var(--code-bg);
    border-color: var(--text-tertiary);
  }
</style>
