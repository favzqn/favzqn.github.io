---
import IndexLayout from '@/layouts/IndexLayout.astro'
import About from '@/components/widgets/About.astro'
import { getCollection } from 'astro:content'
import { themeConfig } from '@/config'

const projects = await getCollection('projects')
const featured = projects
  .filter(p => p.data.featured)
  .sort((a, b) => (a.data.title > b.data.title ? 1 : -1))
  .slice(0, 4)
---

<IndexLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <About />
  
  <section class="featured">
    <h2>Featured Work</h2>
    <div class="featured-grid">
      {featured.map((project) => (
        <a href={`/projects/${project.id}`} class="featured-card">
          {project.data.image && (
            <div class="featured-image">
              <img src={`/projects/${project.data.image}`} alt={project.data.title} loading="lazy" />
            </div>
          )}
          <div class="featured-content">
            <h3>{project.data.title}</h3>
            <p>{project.data.description}</p>
          </div>
        </a>
      ))}
    </div>
    <a href="/projects" class="view-all">View all projects →</a>
  </section>

  <section class="contact">
    <h2>Get in Touch</h2>
    <p>If you have a project in mind or want to collaborate, feel free to reach out.</p>
    <a href="mailto:fauzan08fauzan@gmail.com" class="contact-link">fauzan08fauzan@gmail.com</a>
  </section>
</IndexLayout>

<style>
  .featured {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  
  .featured h2 {
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    margin: 0 0 1.5rem 0;
  }
  
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  
  @media (max-width: 768px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }
  
  .featured-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }
  
  .featured-card:hover {
    opacity: 0.8;
  }
  
  .featured-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 6px;
    margin-bottom: 0.75rem;
    background: var(--code-bg);
  }
  
  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .featured-content h3 {
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    margin: 0 0 0.25rem 0;
  }
  
  .featured-content p {
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }
  
  .view-all {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: var(--font-size-s);
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--mono);
  }
  
  .view-all:hover {
    text-decoration: underline;
    text-decoration-color: var(--text-tertiary);
  }
  
  .contact {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  
  .contact h2 {
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    margin: 0 0 0.5rem 0;
  }
  
  .contact p {
    font-size: var(--font-size-m);
    color: var(--text-secondary);
    margin: 0 0 1rem 0;
    line-height: 1.6;
  }
  
  .contact-link {
    font-size: var(--font-size-m);
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--mono);
    padding: 0.4rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    display: inline-block;
    transition: all 0.2s ease;
  }
  
  .contact-link:hover {
    background: var(--code-bg);
    border-color: var(--text-tertiary);
  }
</style>// deploy
