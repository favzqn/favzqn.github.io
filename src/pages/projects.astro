---
import IndexLayout from '@/layouts/IndexLayout.astro'
import ProjectsWidget from '@/components/widgets/Projects.astro'
import { themeConfig } from '@/config'
---

<IndexLayout
  title={`Projects · ${themeConfig.site.title}`}
  description={themeConfig.site.description}
  ogImage="/open-graph/projects.png"
>
  <div style="margin-top: 2rem;">
    <h1 style="margin-bottom: 0.5rem; font-size: 2rem; font-weight: 700;">Projects</h1>
    <p style="margin-bottom: 3rem; color: var(--text-secondary); font-size: 1.1rem;">
      Featured: financial reconciliation (Go), a public-service incident data pipeline (Python), and an offline-first Android app. Plus full-stack work, chatbots, and smaller experiments.
    </p>
    <ProjectsWidget />
  </div>
</IndexLayout>