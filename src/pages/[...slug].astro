---
import { type CollectionEntry, getCollection } from 'astro:content'
import PostLayout from '@/layouts/PostLayout.astro'
import { render } from 'astro:content'
import { getSortedFilteredPosts } from '@/utils/draft'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts
    .filter((post) => !post.id.startsWith('_'))
    .map((post) => ({
      params: { slug: post.id },
      props: post
    }))
}

type Props = CollectionEntry<'posts'>

const post = Astro.props
const { Content, remarkPluginFrontmatter } = await render(post)

const readingTime = remarkPluginFrontmatter.readingTime
const toc = remarkPluginFrontmatter.toc || []

// Related posts: same category > shared tags > most recent
const related = (await getSortedFilteredPosts())
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    entry: p,
    score:
      (p.data.category && p.data.category === post.data.category ? 2 : 0) +
      (p.data.tags || []).filter((t) => (post.data.tags || []).includes(t)).length
  }))
  .sort((a, b) => b.score - a.score || b.entry.data.pubDate.getTime() - a.entry.data.pubDate.getTime())
  .slice(0, 2)
  .map(({ entry }) => ({
    title: entry.data.title,
    href: '/' + entry.id.replace(/\.(md|mdx)$/, ''),
    description: entry.data.description || ''
  }))
---

<PostLayout {...post.data} readingTime={readingTime} toc={toc} related={related}>
  <Content />
</PostLayout>
