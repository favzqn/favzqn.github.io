---
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostList from '@/components/widgets/PostList.astro'
import { themeConfig } from '@/config'
import { getPublishedNotes, noteCategory, noteDate } from '@/utils/garden'
import type { CollectionEntry } from 'astro:content'

const notes = await getPublishedNotes()

// Shape garden notes as post-list items (PostList expects CollectionEntry<'posts'>)
const asItems = (list: typeof notes) =>
  list.map((n) => ({
    id: n.id,
    data: {
      title: n.data.title,
      pubDate: noteDate(n),
      category: noteCategory(n.id)
    }
  })) as unknown as CollectionEntry<'posts'>[]

const isSynthesis = (n: (typeof notes)[number]) => noteCategory(n.id) === 'synthesis'
const isArticle = (n: (typeof notes)[number]) => noteCategory(n.id) === 'articles'
const isBookMain = (n: (typeof notes)[number]) =>
  noteCategory(n.id) === 'books' && n.data.type === 'source'

// Curated entry points so visitors don't need to know note titles already.
// ponytail: hand-picked IDs; promote to frontmatter-driven paths when list grows past ~6
const byId = new Map(notes.map((n) => [n.id, n]))
const startPaths = [
  {
    label: 'Attention & focus',
    blurb: 'Why focus is a sleep-and-energy problem before it is a willpower problem.',
    ids: [
      'synthesis/the-attention-stack',
      'synthesis/flow-wu-wei-and-deep-focus',
      'books/a-mind-for-numbers/a-mind-for-numbers'
    ]
  },
  {
    label: 'Communication & persuasion',
    blurb: 'What actually works in conversations, from nine books compared.',
    ids: [
      'synthesis/the-influence-spectrum',
      'books/conversationally-speaking/conversationally-speaking',
      'books/exactly-what-to-say/exactly-what-to-say',
      'books/persuasion-tactics/persuasion-tactics'
    ]
  },
  {
    label: 'Wealth & behavior',
    blurb: 'Money as a side effect of temperament and systems.',
    ids: [
      'synthesis/the-architecture-of-wealth',
      'books/the-intelligent-investor/the-intelligent-investor',
      'synthesis/the-desire-happiness-inverse'
    ]
  },
  {
    label: 'Learning how to learn',
    blurb: 'Techniques with evidence, and the illusions that undermine them.',
    ids: ['synthesis/learning-how-to-learn', 'books/a-mind-for-numbers/a-mind-for-numbers']
  }
]
  .map((p) => ({ ...p, items: p.ids.map((id) => byId.get(id)).filter((n) => !!n) }))
  .filter((p) => p.items.length > 0)

// Curated sections first; the long concept tail stays reachable but collapsed.
const sections = [
  { label: 'Synthesis', items: notes.filter(isSynthesis), collapsible: false },
  { label: 'Books', items: notes.filter(isBookMain), collapsible: false },
  { label: 'Articles', items: notes.filter(isArticle), collapsible: false },
  {
    label: 'Concepts & people',
    items: notes.filter((n) => !isSynthesis(n) && !isArticle(n) && !isBookMain(n)),
    collapsible: true
  }
].filter((s) => s.items.length > 0)
---

<IndexLayout
  title={`Garden · ${themeConfig.site.title}`}
  description="Notes, book summaries, and working knowledge from Fauzan's digital garden."
  ogImage="/open-graph/garden.png"
>
  <header class="garden-head">
    <h1>Garden</h1>
    <p class="garden-intro">
      <mark>{notes.length} evergreen notes</mark> — book summaries, cross-book synthesis, and
      working concepts. The raw material behind the <a href="/blog">Blog</a>.
    </p>
    <div class="garden-search" id="garden-search"></div>
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <script is:inline src="/pagefind/pagefind-ui.js" defer></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (window.PagefindUI) {
          new window.PagefindUI({
            element: '#garden-search',
            showImages: false,
            showSubResults: true
          })
        } else {
          const el = document.getElementById('garden-search')
          if (el) el.style.display = 'none'
        }
      })
    </script>
  </header>

  {
    startPaths.length > 0 && (
      <section class="garden-section garden-start">
        <h2>
          Start here
          <span class="count">{startPaths.length} paths</span>
        </h2>
        <div class="path-grid">
          {startPaths.map((path) => (
            <div class="path-card">
              <h3>{path.label}</h3>
              <p class="path-blurb">{path.blurb}</p>
              <ul>
                {path.items.map(
                  (n) =>
                    n && (
                      <li>
                        <a href={`/garden/${n.id}/`}>{n.data.title}</a>
                      </li>
                    )
                )}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    sections.map((section) =>
      section.collapsible ? (
        <details class="garden-section garden-section-more">
          <summary>
            <h2>
              {section.label}
              <span class="count">{section.items.length}</span>
              <svg class="chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </h2>
          </summary>
          <PostList posts={asItems(section.items)} basePath="/garden/" />
        </details>
      ) : (
        <section class="garden-section">
          <h2>
            {section.label}
            <span class="count">{section.items.length}</span>
          </h2>
          <PostList posts={asItems(section.items)} basePath="/garden/" />
        </section>
      )
    )
  }
</IndexLayout>

<style>
  .garden-head {
    margin-top: 2rem;
  }

  .garden-head h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
    font-weight: 700;
  }

  .garden-intro {
    margin: 0 0 1.25rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 42rem;
  }

  .garden-search {
    min-height: 3rem;
    margin-top: 0;
    --pagefind-ui-primary: var(--text-primary);
    --pagefind-ui-text: var(--text-secondary-strong);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-background: transparent;
    --pagefind-ui-font: var(--sans);
  }

  .garden-search :where(input.pagefind-ui__search-input) {
    border-radius: 6px;
    background: transparent;
  }

  .garden-section {
    margin-top: 2.5rem;
  }

  .path-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .path-grid {
      grid-template-columns: 1fr;
    }
  }

  .path-card {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: border-color 0.2s ease;
  }

  .path-card:hover {
    border-color: var(--text-tertiary);
  }

  .path-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
  }

  .path-blurb {
    margin: 0 0 0.65rem;
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .path-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .path-card a {
    font-family: var(--mono);
    font-size: var(--font-size-s);
    color: var(--text-primary);
    text-decoration: none;
  }

  .path-card a:hover {
    text-decoration: underline;
    text-decoration-color: var(--text-tertiary);
  }

  .garden-section h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
    font-weight: var(--font-weight-bold);
  }

  .count {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 400;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-secondary);
  }

  .garden-section-more summary {
    cursor: pointer;
    list-style: none;
  }

  .garden-section-more summary::-webkit-details-marker {
    display: none;
  }

  .garden-section-more summary h2 {
    margin-bottom: 0;
  }

  .garden-section-more .chev {
    transition: transform 0.15s ease;
    color: var(--text-secondary);
  }

  .garden-section-more[open] .chev {
    transform: rotate(180deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .garden-section-more summary:hover h2 {
      color: var(--text-primary);
    }

    .garden-section-more summary:hover .count {
      border-color: var(--text-tertiary);
    }
  }
</style>

